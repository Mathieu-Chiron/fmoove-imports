# Accès à l'application
APP_USER=fairmoove
APP_PASSWORD=

# Payt — API d'import (identifiants fournis par Payt)
PAYT_ADMINISTRATION_CODE=
PAYT_API_TOKEN=          # token statique, envoyé en en-tête Authorization
PAYT_IMPORT_TOKEN=       # token d'importation, envoyé dans le corps
PAYT_IMPORT_URL=https://backend.paytsoftware.com/import/files/csv
PAYT_FILENAME_PATTERN=%Y%m%d.csv

# Archivage Object Storage (optionnel mais recommandé)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SMTP — envoi des rapports (réponses aux emails d'import + alertes équipe)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=            # adresse expéditrice des rapports
ALERT_TO=             # équipe, pour les alertes des envois via la page web

# Réception par email : boîte IMAP relevée par le cron
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=            # ex. imports@votredomaine
IMAP_PASSWORD=        # mot de passe d'application IMAP
INBOUND_ALLOWLIST=    # expéditeurs autorisés, séparés par des virgules
POLL_TOKEN=           # jeton protégeant /poll-inbox (déclenché par le cron)
