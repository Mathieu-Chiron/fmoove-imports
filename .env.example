# Global
PAYT_IMPORT_URL=https://backend.paytsoftware.com/import/files/csv
PAYT_FILENAME_PATTERN=%Y%m%d.csv
POLL_TOKEN=              # jeton protégeant /poll-inbox (déclenché par le cron)

# Registre des clients (multi-tenant) : un tableau JSON, une entrée par client.
# Chaque client a sa boîte mail (IMAP+SMTP) et sa propre administration Payt.
# Astuce : compacter en une seule ligne pour l'injecter en variable d'env.
TENANTS_JSON=[
  {
    "name": "Fairmoove",
    "imap_host": "ssl0.ovh.net", "imap_port": 993,
    "smtp_host": "ssl0.ovh.net", "smtp_port": 587,
    "mailbox_user": "fairmoove@mondomaine",
    "mailbox_password": "········",
    "from_addr": "fairmoove@mondomaine",
    "administration_code": "FAIRMOOVE",
    "api_token": "········",
    "import_token": "········",
    "allowed_senders": ["compta@fairmoove.fr"]
  }
]

# Archivage Object Storage (optionnel mais recommandé)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY=
