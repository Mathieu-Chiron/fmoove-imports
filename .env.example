# Global
PAYT_IMPORT_URL=https://backend.paytsoftware.com/import/files/csv
PAYT_FILENAME_PATTERN=%Y%m%d.csv
POLL_TOKEN=              # jeton protégeant /poll-inbox (déclenché par le cron)

# Boîte catch-all : reçoit tous les alias client@mondomaine (IMAP) et répond (SMTP)
MAILBOX_IMAP_HOST=       # ex. ssl0.ovh.net
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=       # ex. ssl0.ovh.net (défaut : = IMAP host)
MAILBOX_SMTP_PORT=587
MAILBOX_USER=            # ex. imports@mondomaine (le compte réel)
MAILBOX_PASSWORD=        # mot de passe d'application de la boîte
MAILBOX_FROM=            # « De : » par défaut des rapports (défaut : = MAILBOX_USER)

# Registre des clients : un tableau JSON, une entrée par client.
# Chaque client est identifié par son alias (inbox_address) et a sa propre
# administration Payt. « from_addr » optionnel : l'alias, si « send-as » autorisé.
TENANTS_JSON=[
  {
    "name": "Fairmoove",
    "inbox_address": "fairmoove@mondomaine",
    "administration_code": "FAIRMOOVE",
    "api_token": "········",
    "import_token": "········",
    "allowed_senders": ["compta@fairmoove.fr"],
    "from_addr": "fairmoove@mondomaine"
  }
]

# Archivage Object Storage (optionnel mais recommandé)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
